FoamFile
{
    version         2.0;
    format          ascii;

    root            "";
    case            "";
    instance        "";
    local           "";

    class           dictionary;
    object          referenceVariableProperties;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

f
{
    interpolationScheme     cellPoint;
}

z
{
    interpolationScheme     cellPoint;
}

sPx
{

    SDEModel    scalarShadowPosition;
    randomSeed  5489;

    a   1;//abar using a value for "a" of 0.97;
    b   3.895;//7.79;
    variableLambda yes;

    component   x;

    interpolationSchemes
    {
/*        U.component(0)          cellPoint;*/
        U                       cellPoint;
        D                       cellPoint;
        Dt                      cellPoint;
        DeltaE                cellPoint;
        vb                      cellPoint;
    }
}

